# Copy to .env. NEVER commit .env
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
# Exact address of the frontend (scheme + host + port, no trailing slash). localhost and 127.0.0.1 are different!
FRONTEND_ORIGIN=http://localhost:5173
# strict = frontend and API on same site (localhost, or subdomains like app.x.com + api.x.com)
# none   = completely different domains (needs HTTPS; some browsers block these cookies)
COOKIE_SAMESITE=strict
# Path to the database file created by the takehelp-database package
DB_PATH=./data.db
STORAGE_DIR=./storage
TZ=Asia/Kolkata
# Admin account (created at startup if missing). RESET_ADMIN_PASSWORD=1 makes the password always match ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
RESET_ADMIN_PASSWORD=1
